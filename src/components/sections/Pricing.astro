---
import { PricingCards } from '../ui/PricingCards'

const subscriptionFeatures = [
  'Split-tender checkout (cash, card, e-transfer, store credit)',
  'Byte-exact McKesson catalogue import',
  'Auditable customer credit ledger',
  'Reports that net out refunds & discounts',
  'Cost-based tiered pricing engine',
  'Verified nightly backups',
  'Manager & cashier role permissions',
]

const plans = [
  {
    name: 'Unlimited Terminals',
    price: 70,
    yearlyPrice: 50,
    period: 'month',
    features: [...subscriptionFeatures, { text: 'Unlimited terminals', highlight: true }],
    description: 'Billed monthly at $70, or $50/mo when billed annually.',
    buttonText: 'Book a walkthrough',
    href: '#contact',
    isPopular: false,
  },
  {
    name: 'Subscription',
    price: 50,
    yearlyPrice: 30,
    period: 'month',
    features: [...subscriptionFeatures, '1 terminal'],
    description: 'Billed monthly at $50, or $30/mo when billed annually.',
    buttonText: 'Book a walkthrough',
    href: '#contact',
    isPopular: true,
  },
  {
    name: 'One-Time Purchase',
    isCustom: true,
    customPrice: 'Custom',
    features: [
      'Own your license outright, no recurring subscription',
      'Same core feature set as the subscription plan',
      'Pricing scoped to your pharmacy’s setup',
    ],
    description: 'For pharmacies that would rather buy outright than subscribe.',
    buttonText: 'Contact sales',
    href: '#contact',
    isPopular: false,
  },
]
---
<section id="pricing" class="texture-dots relative overflow-hidden bg-slate-50 border-y border-slate-200">
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_50%_60%_at_50%_100%,theme(colors.teal.light),transparent)]"
    aria-hidden="true"
  ></div>
  <div class="relative mx-auto max-w-6xl px-6 pt-6 md:pt-10 pb-4 md:pb-6">
    <PricingCards plans={plans} client:visible />
    <div class="mt-5 md:mt-4 flex flex-wrap justify-center gap-x-8 gap-y-1.5 text-center">
      <p class="flex items-center gap-1.5 text-xs font-medium text-ink">
        <svg class="h-4 w-4 flex-shrink-0 text-teal-dark" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16.6 5.6 8.3 14 3.4 9.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Free 2-hour staff training, included
      </p>
      <p class="flex items-center gap-1.5 text-xs font-medium text-ink">
        <svg class="h-4 w-4 flex-shrink-0 text-teal-dark" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16.6 5.6 8.3 14 3.4 9.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Free live demo, included
      </p>
      <p class="flex items-center gap-1.5 text-xs font-medium text-ink">
        <svg class="h-4 w-4 flex-shrink-0 text-teal-dark" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16.6 5.6 8.3 14 3.4 9.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Setup costs included, no surprise fees
      </p>
      <p class="flex items-center gap-1.5 text-xs font-medium text-ink">
        <svg class="h-4 w-4 flex-shrink-0 text-teal-dark" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16.6 5.6 8.3 14 3.4 9.1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        No new hardware. Runs on what you already have
      </p>
    </div>
  </div>
</section>
